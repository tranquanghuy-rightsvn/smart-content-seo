msgstr "Dùng lại màu của site"

#: includes/class-smc-admin.php:294
msgid "Text handling"
msgstr "Cách dùng chữ"

#: includes/class-smc-admin.php:296
msgid "Keep my wording, only restyle it"
msgstr "Giữ nguyên chữ của tôi, chỉ trình bày lại"

#: includes/class-smc-admin.php:297
msgid "Let the AI rewrite and expand"
msgstr "AI được viết lại và bổ sung"

#: includes/class-smc-admin.php:299
